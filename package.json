{
  "name": "mumu-game",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run check:content && npm run check:assets && npm run sweep",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:src": "eslint src tools",
    "check:content": "node tools/check-content.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "test:play": "node --experimental-vm-modules tools/verify-playable.mjs",
    "sweep": "node tools/sweep-logs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0"
  }
}
