    },
    "restore_started": {
      "name": "restore_started",
      "description": "開始恢復購買",
      "params": [],
      "trigger": "點擊恢復購買"
    },
    "team_viewed": {
      "name": "team_viewed",
      "description": "查看隊伍列",
      "params": [
        "count"
      ],
      "trigger": "隊伍列渲染"
    },
    "session_end": {
      "name": "session_end",
      "description": "session 結束（頁面離開或隱藏）",
      "params": [
        "chapter",
        "sessionMs"
      ],
      "trigger": "pagehide／visibilitychange"
    },
    "crash": {
      "name": "crash",
      "description": "未捕捉例外或 Promise 拒絕",
      "params": [
        "kind",
        "where"
      ],
      "trigger": "全域錯誤攔截"
    },
    "vitals": {
      "name": "vitals",
      "description": "Web Vitals 量測值",
      "params": [
        "inp",
        "cls",
        "fcp"
      ],
      "trigger": "效能量測回報"
    }
  }
}
